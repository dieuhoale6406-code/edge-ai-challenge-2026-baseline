CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# PSRAM bat buoc: tensor arena detection ~1.5 MB (conv1 out 240x320x16 int8).
# Board N16R8 / N8R8 = Octal. Board Quad PSRAM -> CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_LWIP_MAX_SOCKETS=16

# Camera OV7670: cau hinh giong firmware Arduino da kiem tra (esp32s3_ov7670_test):
# DMA vao bo dem noi roi chep sang PSRAM (khong dung PSRAM DMA), task camera o core 0.
CONFIG_OV7670_SUPPORT=y
# CONFIG_CAMERA_PSRAM_DMA is not set
CONFIG_CAMERA_CORE0=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
